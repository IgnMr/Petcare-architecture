@startuml
left to right direction

actor Cliente as C
actor Recepcionista as R
actor Veterinario as V

package "Sistema PetCare" {
    usecase "Agendar Cita Médica" as UC_Agendar
    usecase "Validar Disponibilidad" as UC_Validar
    usecase "Registrar Ficha Mascota" as UC_Ficha
    usecase "Emitir Diagnóstico y Receta" as UC_Receta
    usecase "Generar Cobro Extraordinario" as UC_Cobro
}

C --> UC_Agendar
R --> UC_Ficha
R --> UC_Agendar

' Agendar exige verificar disponibilidad obligatoriamente
UC_Agendar .> UC_Validar : <<include>>

V --> UC_Receta

' Si hay insumos extra en la atención, extiende a generar cobro
UC_Cobro .> UC_Receta : <<extend>>

@enduml