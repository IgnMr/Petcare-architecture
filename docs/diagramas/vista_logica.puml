@startuml

class Tutor{

    -rut:Int

    -nombre:String

    -apellido_Paterno:String

    -apellido_Materno:String

    -numero_Telefono:Int

    -correo:String

    +actualizarContacto():Boolean

}

class Mascota{

    -id_Mascota:Int

    -nombre:String

    -especie:String

    +calcularEdad():int

}



class FichaMedica{

    -idFicha:Int

    -fecha:Timestamp

    -peso:float

    -motivoCita:String

    -diagnostico:String

    +registrarAtencion():Boolean

}



class Cita{

    -idCita:Int

    -fechaAtencion:Timestamp

    -razonAtencion:String

    -estadoAtencion:String

    +guardarCita():Boolean



}



class Veterinario{

    -rut:Int

    -nombre:String

    -especialidad:String

    -numero_Telefono_:int

    -correo:String

    +firmarReceta():Boolean

}



class Vacuna{

    -idVacuna:Int

    -nombreVacuna:String

    -tipoVacuna:String

    -fechaAplicacion:date

    -fecha_Proxima_Dosis:date

    +aplicarDosis():Boolean

}



class Tratamiento{

    -idTratamiento:Int

    -tipoTratamiento:String

    -tiempoTratamiento:String

    +asignarTratamiento():Boolean

}



