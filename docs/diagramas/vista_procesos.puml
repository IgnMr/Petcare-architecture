@startuml
autonumber
actor Recepcionista as R
boundary "AgendarCitaView" as View
control "CitaController" as Ctrl
entity "CitaMedica" as Entity
database "Database" as DB

R -> View : 1. Selecciona fecha y cliente
activate View
View -> Ctrl : 2. crearCita(datos)
activate Ctrl
Ctrl -> Entity : 3. validarDisponibilidad()
activate Entity
Entity --> Ctrl : 4. disponible (true)
deactivate Entity
Ctrl -> DB : 5. guardarRegistro()
activate DB
DB --> Ctrl : 6. OK
deactivate DB
Ctrl --> View : 7. Cita agendada con éxito
deactivate Ctrl
View --> R : 8. Muestra confirmación
deactivate View
@enduml